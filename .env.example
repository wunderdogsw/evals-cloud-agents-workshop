# Copy to .env (gitignored). Read by the eval kit, agent-evals and the sample app.

# How model calls are made (default: auto-detect in this order):
#   claude-code — `claude -p` with your Claude Code login (Claude subscription, no API key)
#   cursor      — `agent -p` with your Cursor login (or CURSOR_API_KEY)
#   api         — Anthropic API with ANTHROPIC_API_KEY
# EVALS_PROVIDER=claude-code

# Only for EVALS_PROVIDER=cursor: a Cursor model name (otherwise Cursor's default)
# EVALS_CURSOR_MODEL=

# Only for EVALS_PROVIDER=api
# ANTHROPIC_API_KEY=

# Optional model overrides — defaults live in kit/evals/src/models.ts
# EVAL_TASK_MODEL=
# EVAL_JUDGE_MODEL=
# EVAL_AGENT_MODEL=

# Run everything offline with deterministic fakes (no model calls):
# EVALS_MOCK=1
