{
  "name": "workshop-evals",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "description": "Eval suites for this repository. Runner vendored from the Evals & Cloud Agents Workshop kit.",
  "scripts": {
    "eval": "node --import tsx runner/cli.ts run",
    "compare": "node --import tsx runner/cli.ts compare",
    "label": "node --import tsx runner/cli.ts label",
    "calibrate": "node --import tsx runner/cli.ts calibrate",
    "verify": "node --import tsx runner/cli.ts verify"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "tsx": "^4.23.15"
  }
}
